; Exports of reshield.dll (cl /LD ... /link /DEF:reshield.def). A header-wide __declspec(dllexport)
; macro would touch every declaration, so the exports are listed here instead. Only the subset an
; engine binding needs is exported; a POSIX shared library exposes the whole public API.
LIBRARY reshield
EXPORTS
    reshield_verify_code_section
    reshield_code_scan_begin
    reshield_code_scan_step
    reshield_verify_code_page_wx
    reshield_verify_app
    reshield_check_json
    reshield_report_to_json
    reshield_status_name
    reshield_platform_name
    reshield_load_verified_app_asset
    reshield_free_asset
